# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

# ── Core ───────────────────────────────────────────────────────────────────────

project_name       = "yourname-akamai-lab"    # prefix applied to all AWS resource names
aws_region         = "us-east-2"
aws_profile        = "SA_Standard_Access-491489166083"  # AWS SSO profile
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-2a", "us-east-2b"]
instance_type      = "t3.small"

# Your public IP — restricts SSH access to the bastion and the Kong Admin API (port 8001).
# Find it with: curl -s https://ifconfig.me
# 'make apply' and 'make plan' auto-detect your current IP and pass it as -var admin_cidr=...
# so this value is used only for 'terraform apply' run outside of make.
admin_cidr         = "YOUR_IP/32"

# ── Noname sensor plugins (set by 'make plugin-images' — do not edit manually) ──
#
# These are written automatically to terraform/plugin.auto.tfvars after running
# 'make plugin-images' and 'make provision-plugins'. You do not need to set them here.
# They are documented below for reference only.
#
# kong_image            = "123456789.dkr.ecr.us-east-2.amazonaws.com/yourname-akamai-lab/kong:latest"
# nginx_image           = "123456789.dkr.ecr.us-east-2.amazonaws.com/yourname-akamai-lab/nginx:latest"
# noname_plugin_enabled = true
# noname_nginx_source_key   = "<written by make provision-plugins>"
# noname_nginx_source_index = 1

# ── Noname AWS ECS sensor (DaemonSet) — required for Flex Gateway visibility ──
#
# Source: in your Noname tenant, go to
#   Settings → Integrations → Traffic Sources → Add Integration → AWS ECS tile.
# Select EC2 (not Fargate), pick your engine, click Create. Noname provides a
# CloudShell shell script with the values below baked into env vars; copy them
# here. Without these the sensor module deploys with empty defaults and the
# ECS task will fail to start.
#
# noname_engine_url             = "https://<tenant>.nonamesec.com/engine"
# noname_sniff_source_key       = "<from script ENV: SNIFF_SOURCE_KEY>"
# noname_sniff_source_index     = 1
# noname_sniff_source_type      = 201             # AWS ECS sensor type
# noname_should_use_ebpf        = false           # set true to also sniff TLS-decrypted traffic
# noname_sensor_image           = "us-central1-docker.pkg.dev/noname-artifacts/nns-docker/noname-sensor:3.3.54"
# noname_jfrog_credentials_json = <<EOT
# { "username": "_json_key_base64", "password": "<base64 GCP SA key from script>" }
# EOT
