worker_processes auto;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include      /usr/local/openresty/nginx/conf/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /dev/stdout main;
    sendfile        on;
    keepalive_timeout 65;

    lua_package_path '/usr/local/openresty/nginx/lua-scripts/?.lua;;';

    # AWS ALBs rotate node IPs over time. NGINX's `upstream` directive and a
    # bare `proxy_pass http://hostname` only resolve DNS ONCE at config load
    # and cache the IP forever — once AWS rotates the ALB node, NGINX keeps
    # hitting the dead IP and every request returns 502 ("connect() failed
    # (113: No route to host) while connecting to upstream").
    #
    # Fix: configure a runtime resolver and use a variable in proxy_pass so
    # the hostname is re-resolved at request time. valid=10s caches each
    # answer briefly so we don't DNS-lookup on every request.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    log_by_lua_block {
        local logger = require "noname_logger"
        logger.log()
    }

    init_worker_by_lua_block {
        local init_worker = require "init_worker"
        init_worker.init_worker()
    }

    server {
        listen 80;
        server_name _;

        # Apps ALB DNS — substituted at container startup by entrypoint.sh.
        # Held in a variable so proxy_pass below uses the resolver at request
        # time instead of caching the IP at config load.
        set $apps_alb "${APPS_ALB_DNS}";

        # Noname code starts
        set $noname_req_body "";
        access_by_lua_file /usr/local/openresty/nginx/lua-scripts/access.lua;
        set $noname_resp_body "";
        body_filter_by_lua_file /usr/local/openresty/nginx/lua-scripts/body_filter.lua;
        # Noname code ends

        location /health {
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }

        location /nginx_status {
            stub_status on;
            allow 127.0.0.1;
            deny all;
        }

        # NGINX gotcha: with a static upstream + `proxy_pass http://up/` the
        # location prefix gets auto-stripped from the URI. With a variable
        # in proxy_pass that auto-strip is gone — the upstream sees the full
        # /vampi/... URI and returns 405. Use `rewrite ... break` to strip
        # the prefix manually before proxying, and drop the trailing slash
        # on proxy_pass so the rewritten URI is what gets sent.
        location /vampi/ {
            rewrite ^/vampi/(.*)$ /$1 break;
            proxy_pass         http://$apps_alb:5000;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location /dvga/ {
            rewrite ^/dvga/(.*)$ /$1 break;
            proxy_pass         http://$apps_alb:5013;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location / {
            return 200 "NGINX lab gateway - routes: /vampi/ /dvga/\n";
            add_header Content-Type text/plain;
        }
    }
}
